# Copy to .env and replace every CHANGE_ME value before starting.
MYSQL_DATABASE=prosper_vista
MYSQL_USER=pvr_user
MYSQL_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD
DATABASE_URL=mysql+pymysql://pvr_user:CHANGE_ME_LONG_RANDOM_DB_PASSWORD@db:3306/prosper_vista
APP_PORT=8082
APP_SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
COOKIE_SECURE=false
# Optional generic live-price JSON API adapter. Leave blank until a licensed provider is selected.
LIVE_PRICE_API_URL=
LIVE_PRICE_API_KEY=
LIVE_PRICE_API_KEY_HEADER=Authorization
LIVE_PRICE_API_KEY_PREFIX=Bearer
